    <key>UIFileSharingEnabled</key><true/>
    <key>LSSupportsOpeningDocumentsInPlace</key><true/>
    <key>CFBundleDocumentTypes</key><array><dict>
        <key>CFBundleTypeName</key><string>Game ROM or archive</string>
        <key>CFBundleTypeRole</key><string>Viewer</string>
        <key>LSHandlerRank</key><string>Alternate</string>
        <key>LSItemContentTypes</key><array><string>public.data</string><string>public.archive</string></array>
    </dict></array>
    <key>GCSupportsControllerUserInteraction</key><true/>
    <key>NSCameraUsageDescription</key><string>Claw uses the camera to provide camera input to games you run.</string>
    <key>NSMicrophoneUsageDescription</key><string>Claw uses the microphone to provide microphone input to games you run.</string>
</dict></plist>
