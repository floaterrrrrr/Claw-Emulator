# Copy to .env. Local env files are ignored by Git; exported variables override them.
# Unsigned builds work without an env file, using com.example.claw.
CLAW_APPLE_TEAM_ID=
CLAW_BUNDLE_ID=com.example.claw
CLAW_ASC_APP_ID=

# Export compliance: empty preserves the owner's declaration in App/Info.plist.
# false = no non-exempt encryption (including documentation-exempt encryption).
# true = non-exempt encryption; provide Apple's approval code when required.
# App/Info.plist currently declares false following the owner's completed exemption.
# Set these only to override that declaration for a future distribution decision.
CLAW_USES_NON_EXEMPT_ENCRYPTION=
CLAW_ENCRYPTION_EXPORT_COMPLIANCE_CODE=

# Optional Cloud investigation override: source or legacy-diagnostic.
# Empty inherits Distribution/ffmpeg-build-policy.json. Legacy is testing-only.
CLAW_FFMPEG_MODE=

# Optional Xcode selection for scripts; does not change the system-wide selection.
CLAW_DEVELOPER_DIR=

# Optional App Store Connect API authentication. Otherwise use Xcode Apple Accounts.
# Keep the .p8 file outside the repository or inside the ignored .secrets directory.
# Supply all three together. Never put private-key contents or passwords here.
CLAW_ASC_API_KEY_ID=
CLAW_ASC_API_ISSUER_ID=
CLAW_ASC_API_PRIVATE_KEY_PATH=
